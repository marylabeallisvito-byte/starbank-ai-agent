# =====================================================================
# 环境变量模板（提交到版本库，便于团队协作；复制为 .env 后填写真实值）
# 复制命令：cp .env.example .env
# =====================================================================

# ---- Neo4j 图数据库连接配置 ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_CONNECTION_TIMEOUT=2.0
# 本地开发默认开启；生产环境可设为 false，使依赖故障明确返回 503。
GRAPH_FALLBACK_ENABLED=true

# 对外提供页面时设为 production 并设置高强度复核口令；不配置则禁止服务端复核写入与审计读取。
APP_ENV=development
REVIEW_API_TOKEN=
# 跨域部署时只填写实际前端域名，多个域名用逗号分隔。同域部署不需要额外 CORS。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 银行智能体竞赛沙箱：开发环境默认可用；生产环境必须显式设为 1 才开放。
# 所有账户和交易均为合成模拟数据；通行密钥使用设备真实签名，不连接真实支付通道。
BANKING_SANDBOX_ENABLED=0
BANKING_AUTH_MODE=passkey
BANKING_WEBAUTHN_RP_ID=localhost
BANKING_WEBAUTHN_ORIGIN=http://localhost:5173
# 独立复核员令牌，至少 24 个随机字符。不要复用客户会话或旧风控复核令牌。
BANKING_OPERATOR_TOKEN=
# 敏感文本字段加密。用 manage_banking_storage init 生成，切勿复用 API 密钥。
BANKING_DATA_ENCRYPTION_KEY=
# 轮换时保留的历史数据密钥，逗号分隔；不要随意移除，否则旧备份可能无法恢复。
BANKING_DATA_PREVIOUS_KEYS=
# 可选：银行沙箱 SQLite 路径，默认 backend/data/banking.sqlite3
# BANKING_SANDBOX_DB=

# ---- LLM 配置（供后续 LangChain / LangGraph 多 Agent 使用）----
# 按需替换为实际服务商（OpenAI / DeepSeek / 通义千问 等），base 与 model 需对应调整
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 银行页面的可选语义分类。默认关闭；仅发送用户输入与虚构联系人/订阅目录。
# OpenAI 使用严格结构化输出；DeepSeek 使用 JSON mode + 服务端 Pydantic 校验。
# 调用失败自动退回确定性规则。
BANKING_LLM_ENABLED=0
# BANKING_LLM_MODEL=gpt-4o

# Plaid external read-only Sandbox (never use Production credentials here)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate once with cryptography.fernet.Fernet.generate_key(); keep stable and private.
PLAID_TOKEN_ENCRYPTION_KEY=
