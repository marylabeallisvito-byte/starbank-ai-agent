    {"id":"C05","kind":"prepare","text":"核对账单，预留500元，等工资到账再办理","expect":{"status":"BLOCKED"}},
    {"id":"C06","kind":"prepare","text":"核对账单，预留500元，除非工资到账否则别办","expect":{"status":"BLOCKED"}},
    {"id":"S01","kind":"prepare","text":"核对账单，预留500元，至少保留1000元生活费，取消云上视频订阅","expect":{"status":"READY","amount":"500.00","minimum_balance":"1000.00","cancel_subscription":true}},
    {"id":"S02","kind":"prepare","text":"核对账单，预留500元，暂不取消云上视频订阅","expect":{"status":"READY","cancel_subscription":false}},
